# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://produser:prodpassword@prodhost:5432/trusty_prod?schema=public"
JWT_SECRET="generate_a_strong_secret_for_production"
JWT_REFRESH_SECRET="generate_another_strong_secret_for_production"
JWT_EXPIRES_IN="1h"
PORT=3000
NODE_ENV=production
SMTP_HOST=smtp.example.com
SMTP_PORT=587   
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FRONTEND_URL=https://your-production-app.com
MINIO_ENDPOINT=minio.example.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_BUCKET=prod-public
MINIO_PRIVATE_BUCKET=prod-private
